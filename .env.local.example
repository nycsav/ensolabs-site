# ── scripts/publish-linkedin.js — LinkedIn publisher ──────────────────
# Copy this file to .env.local (gitignored — never commit real values) and
# fill in real credentials. Full setup instructions live in the header
# comment of scripts/publish-linkedin.js — read that before using either key.

# Member access token from the LinkedIn Developer portal's token generator.
# Scopes needed: w_member_social, openid, profile. Expires ~60 days from
# generation — regenerate at https://www.linkedin.com/developers/apps when
# the script's 401 hint tells you to.
LINKEDIN_ACCESS_TOKEN=

# Sav's personal LinkedIn member URN, e.g. urn:li:person:XXXXXXXX.
# Get it by running: node scripts/publish-linkedin.js --whoami
# (that call only needs LINKEDIN_ACCESS_TOKEN to be set first).
LINKEDIN_MEMBER_URN=
