# Copy to .env and fill in. Do NOT commit the real .env.
# Exact variable names can vary by ADK release — confirm at:
# https://developer.watson-orchestrate.ibm.com/getting_started/installing

# --- Developer Edition source: how the local server is entitled ---
# "myibm"  -> use an IBM entitlement key (Partner Plus / myibm)
# "orchestrate" -> use a watsonx Orchestrate SaaS instance
WO_DEVELOPER_EDITION_SOURCE=myibm

# --- IBM entitlement key (from myibm.ibm.com container library) ---
WO_ENTITLEMENT_KEY=your-ibm-entitlement-key

# --- watsonx.ai credentials (used by the agent's LLM) ---
WATSONX_APIKEY=your-watsonx-apikey
WATSONX_SPACE_ID=your-watsonx-space-id
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- If connecting to a SaaS instance instead of local ---
# WO_INSTANCE=https://api.<region>.watson-orchestrate.ibm.com/instances/<id>
# WO_API_KEY=your-wxo-api-key
