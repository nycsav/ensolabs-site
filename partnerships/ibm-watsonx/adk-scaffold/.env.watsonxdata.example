# watsonx.data (lakehouse) connection for the Signal Lens Scout tool.
# Copy to .env.watsonxdata and fill in. Get these from the watsonx.data console:
#   Infrastructure manager → your Presto engine → "Connection details".
# The API key is a standard IBM Cloud API key (same kind you made for the ADK).
# NEVER commit the filled-in file.

WXD_HOST=<presto-engine-host>.<region>.lakehouse.appdomain.cloud
WXD_PORT=443
WXD_USER=ibmlhapikey                 # recommended; or your IBMid email
WXD_API_KEY=<your-ibm-cloud-api-key>
WXD_CATALOG=iceberg_data             # your Iceberg catalog
WXD_SCHEMA=market                    # schema holding the signals table
WXD_SIGNALS_TABLE=market_signals     # the table Scout reads
